# Ghazara Sales App - Environment Variables Template

# Prisma Accelerate / Data Platform Connection
# Use the connection string provided in your Prisma Console (https://console.prisma.io)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your-prisma-accelerate-api-key"

# Direct PostgreSQL Connection (Required for Prisma migrations & direct seeds)
DIRECT_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"

# Supabase Client Configuration (Frontend direct access if applicable)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
