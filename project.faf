# Ghazara Sales App - AI Context Specification (application/vnd.faf+yaml)
schema_version: "1.0"

project:
  name: "Ghazara Sales App"
  domain: "charity fundraising + sales commissions"
  locale:
    ui: "ar-YE"
    rtl: true
    currency: "YER"
    timezone: "Asia/Aden"

stack:
  frontend:
    framework: "React 19"
    styling: "Tailwind CSS 4"
    routing: "react-router 7"
  backend:
    orm: "Prisma 6"
    db: "PostgreSQL 16 (Supabase, direct:5432 / pooled:6543)"
    auth: "Supabase Auth (JWT in Authorization header)"
  runtime:
    node: ">=20"
    package_manager: "npm"

conventions:
  api:
    response: "{ data: T | null, error: { code, message } | null }"
    pagination: "cursor-based (cursor, limit, nextCursor)"
    errors: "HTTP status + error.code enum"
  files:
    components: "src/components/<PascalCase>.tsx"
    api: "src/api/<resource>.ts"
  db:
    migrations_only: true   # لا تعديل مباشر على schema.sql بعد أول migration

rbac:
  admin:
    can: ["crud:*", "payroll:approve", "users:manage"]
  marketer:
    can: ["donations:create:own", "donations:read:own", "targets:read:own"]
  charity_rep:
    can: ["donations:read:assigned", "donations:verify:assigned"]

env:
  required: ["DATABASE_URL", "DIRECT_URL", "SUPABASE_URL", "SUPABASE_ANON_KEY"]
  optional: ["SHADOW_DATABASE_URL", "SENTRY_DSN"]

commands:
  dev: "npm run dev"
  test: "vitest run"
  migrate: "prisma migrate dev"
  migrate_prod: "prisma migrate deploy"
  typecheck: "tsc --noEmit"

invariants:
  - "كل donation له marketer_id و amount > 0 و currency ثابت"
  - "لا يمكن حذف donation بعد الموافقة؛ يُعاد فقط عبر reversal"
  - "payroll يُحسب شهريًا ولا يُعدل بعد الإغلاق"

out_of_scope:
  - "multi-tenant"
  - "offline mode"
  - "mobile native app"
